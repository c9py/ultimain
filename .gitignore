# Build artifacts
*.o
*.o.d
*.a
*.so
*.dylib
build/
*.internal

# Python
__pycache__/
*.pyc
*.pyo

# Large downloaded files
research/ultima_collection.iso
research/ultima_collection/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Engine / launcher build directories
# `build/` already ignores untracked trees, but launcher/build was committed
# and checkout was overwriting the SDL3_ttf-linked binary after install.
engines/exult/build/
engines/ultima8/build/
launcher/build/

# Downloaded archives
*.rar
wget-log

# Web launcher disk images (generated from rootfs)
# Keep compressed disk image, exclude uncompressed
web/assets/*.ext2
!web/assets/*.ext2.gz
web/assets/rootfs/lib/
web/assets/rootfs/lib64/
web/assets/rootfs/usr/bin/exult
web/assets/rootfs/usr/bin/pentagram

# OSM2Ultima test output directories
tools/osm2ultima/test_*/
